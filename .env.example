# No environment variables are required for the current foundation build.
# This file documents the ones that will be added in later steps
# (Supabase, Resend, Pexels/Pixabay) so nothing is committed by accident.

# --- Supabase (required for admin + analytics) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=        # server-side only, never exposed to the browser

# --- Resend (added when the contact form / notifications are built) ---
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=OnlyPDF <noreply@your-verified-domain.example>
# CONTACT_TO_EMAIL=hello@onlypdf.online

# --- Blog images ---
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
